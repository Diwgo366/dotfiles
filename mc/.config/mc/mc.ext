# mc.ext — extension file for Midnight Commander
# View: pygmentize (syntax highlighting)
# Edit: nvim

# =============================================================
# CÓDIGO FUENTE (con pygmentize)
# =============================================================

shell/.py:
	View=pygmentize -f terminal256 -O style=dracula %f 2>/dev/null | less -R
	Edit=nvim %f

shell/.js:
	View=pygmentize -f terminal256 -O style=dracula %f 2>/dev/null | less -R
	Edit=nvim %f

