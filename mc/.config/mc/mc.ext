# =============================================================
# ARCHIVOS DE TEXTO GENÉRICOS
# =============================================================

shell/.txt:
	View=%view{cat %f}
	Edit=nvim %f

shell/.log:
	View=%view{cat %f}
	Edit=nvim %f

shell/.csv:
	View=%view{column -t -s, %f 2>/dev/null || cat %f}
	Edit=nvim %f

# =============================================================
# ARCHIVOS COMPRIMIDOS (dentro)
# =============================================================

shell/.tar.gz:
	Open=tar -xzvf %f

shell/.tgz:
	Open=tar -xzvf %f

shell/.tar.bz2:
	Open=tar -xjvf %f

shell/.tar.xz:
	Open=tar -xJvf %f

shell/.zip:
	Open=unzip -l %f

# =============================================================
# IMÁGENES Y PDF (con visor externo)
# =============================================================

shell/.png:
	View=%view{chafa %f 2>/dev/null || echo "Image: %f"}

shell/.jpg:
	View=%view{chafa %f 2>/dev/null || echo "Image: %f"}

shell/.jpeg:
	View=%view{chafa %f 2>/dev/null || echo "Image: %f"}

shell/.gif:
	View=%view{chafa %f 2>/dev/null || echo "Image: %f"}

shell/.svg:
	View=%view{chafa %f 2>/dev/null || echo "Image: %f"}

shell/.pdf:
	View=%view{pdftotext %f - 2>/dev/null || echo "PDF: %f"}

# =============================================================
# DEFAULT
# =============================================================

default/:
	Edit=nvim %f
