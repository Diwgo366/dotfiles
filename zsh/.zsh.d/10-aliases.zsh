# ==============================================================
# ALIASES - Atajos y alias útiles
# ==============================================================

# === Kitty Terminal ===
alias icat='kitten icat'

# === Navegación ===
alias ..='cd ..'
alias ...='cd ../..'

# === Listados ===
alias ls='eza --icons'
alias ll='eza -alh --icons --group-directories-first'
alias la='eza -a --icons'
alias l='eza -F --icons'
alias lsd='eza -D --icons'

# === Utilidades ===
alias dact='deactivate'
alias matlab="/usr/local/MATLAB/R2018a/bin/matlab -nosoftwareopengl"

# === Navegación web ===
alias portal='brave http://neverssl.com >/dev/null 2>&1 &'

# === Git (complementarios) ===
alias gst='git status'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'

alias kmusic='kitty --session ~/.config/kitty/sessions/music.conf'
