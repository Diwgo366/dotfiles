# ==============================================================
# ALIASES - Atajos y alias útiles
# ==============================================================

# === Navegación ===
alias ..='cd ..'
alias ...='cd ../..'

# === Listados ===
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias lsd='ls -d */'  # Listar solo directorios

# === Utilidades ===
alias dact='deactivate'
alias matlab="/usr/local/MATLAB/R2018a/bin/matlab -nosoftwareopengl"

# === Navegación web ===
alias portal='brave-browser http://neverssl.com >/dev/null 2>&1 &'

# === Git (complementarios) ===
alias gst='git status'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
