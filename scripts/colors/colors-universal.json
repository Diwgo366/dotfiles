{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "custom_dotfiles",
    "description": "Personal Dotfiles Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#1e1e2e",
    "bg_alt": "#282a36",
    "bg_elevated": "#333544",
    "bg_overlay": "#3e3e4e",
    "fg": "#f8f8f2",
    "fg_muted": "#a0a0b0",
    "fg_subtle": "#6272a4",
    "border": "#44475a",
    "border_focus": "#f8f8f2",
    "border_subtle": "#3a3a4a"
  },

  "palette": {
    "black": "#262626",
    "red": "#E64747",
    "green": "#42E66C",
    "yellow": "#E4F34A",
    "blue": "#9B6BDF",
    "magenta": "#E356A7",
    "cyan": "#75D7EC",
    "orange": "#EFA554",
    "bright_black": "#7A7A7A",
    "bright_red": "#FF5555",
    "bright_green": "#50FA7B",
    "bright_yellow": "#F1FA8C",
    "bright_blue": "#BD93F9",
    "bright_magenta": "#ff79c6",
    "bright_cyan": "#8BE9FD",
    "bright_white": "#FFB86C"
  },

  "semantic": {
    "primary": { "main": "#9B6BDF", "light": "#BD93F9", "dark": "#7a4fc7", "on": "#1e1e2e" },
    "secondary": { "main": "#75D7EC", "light": "#8BE9FD", "dark": "#5ab8c9", "on": "#1e1e2e" },
    "accent": { "main": "#EFA554", "light": "#FFB86C", "dark": "#c4823d", "on": "#1e1e2e" },
    "error": { "main": "#E64747", "light": "#FF5555", "dark": "#b83838", "on": "#f8f8f2" },
    "warning": { "main": "#E4F34A", "light": "#F1FA8C", "dark": "#b8c23a", "on": "#1e1e2e" },
    "success": { "main": "#42E66C", "light": "#50FA7B", "dark": "#35b855", "on": "#1e1e2e" },
    "info": { "main": "#75D7EC", "light": "#8BE9FD", "dark": "#5ab8c9", "on": "#1e1e2e" }
  },

  "state": {
    "hover": { "bg": "#3e3e4e" },
    "active": { "bg": "#4a4a5a" },
    "focus": { "bg": "#505060", "ring": "#f8f8f2" },
    "disabled": { "fg": "#6272a4", "bg": "#2a2a3a" },
    "selected": { "bg": "#9B6BDF" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Tokyonight-BL-LB-Dark",
    "icon_theme": "Papirus",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "custom_dotfiles" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}