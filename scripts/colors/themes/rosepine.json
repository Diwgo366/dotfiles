{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "rosepine",
    "description": "Rosé Pine Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#191724",
    "bg_alt": "#1f1d2e",
    "bg_elevated": "#26233a",
    "bg_overlay": "#2a273f",
    "fg": "#e0def4",
    "fg_muted": "#908caa",
    "fg_subtle": "#6e6a86",
    "border": "#26233a",
    "border_focus": "#eb6f92",
    "border_subtle": "#191724"
  },

  "palette": {
    "black": "#191724",
    "red": "#eb6f92",
    "green": "#31748f",
    "yellow": "#f6c177",
    "blue": "#9ccfd8",
    "magenta": "#c4a7e7",
    "cyan": "#9ccfd8",
    "orange": "#ea9a97",
    "bright_black": "#26233a",
    "bright_red": "#ebbcba",
    "bright_green": "#42879f",
    "bright_yellow": "#f6c177",
    "bright_blue": "#9ccfd8",
    "bright_magenta": "#c4a7e7",
    "bright_cyan": "#9ccfd8",
    "bright_white": "#e0def4"
  },

  "semantic": {
    "primary": { "main": "#eb6f92", "light": "#ebbcba", "dark": "#d65a7a", "on": "#191724" },
    "secondary": { "main": "#c4a7e7", "light": "#d5b8f0", "dark": "#b088d6", "on": "#191724" },
    "accent": { "main": "#f6c177", "light": "#fad59e", "dark": "#e0ad5d", "on": "#191724" },
    "error": { "main": "#eb6f92", "light": "#ebbcba", "dark": "#d65a7a", "on": "#191724" },
    "warning": { "main": "#f6c177", "light": "#fad59e", "dark": "#e0ad5d", "on": "#191724" },
    "success": { "main": "#31748f", "light": "#42879f", "dark": "#285d70", "on": "#191724" },
    "info": { "main": "#9ccfd8", "light": "#b5dfe5", "dark": "#83b8c1", "on": "#191724" }
  },

  "state": {
    "hover": { "bg": "#1f1d2e" },
    "active": { "bg": "#26233a" },
    "focus": { "bg": "#2a273f", "ring": "#eb6f92" },
    "disabled": { "fg": "#6e6a86", "bg": "#1f1d2e" },
    "selected": { "bg": "#eb6f92" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Rosé-Pine",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "rose-pine" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}