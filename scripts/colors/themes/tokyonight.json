{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "tokyonight",
    "description": "Tokyo Night Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#1a1b26",
    "bg_alt": "#16161e",
    "bg_elevated": "#24283b",
    "bg_overlay": "#414868",
    "fg": "#a9b1d6",
    "fg_muted": "#787c99",
    "fg_subtle": "#565f89",
    "border": "#24283b",
    "border_focus": "#7aa2f7",
    "border_subtle": "#1a1b26"
  },

  "palette": {
    "black": "#15161e",
    "red": "#f7768e",
    "green": "#9ece6a",
    "yellow": "#e0af68",
    "blue": "#7aa2f7",
    "magenta": "#bb9af7",
    "cyan": "#7dcfff",
    "orange": "#ff9e64",
    "bright_black": "#414868",
    "bright_red": "#ff9aa6",
    "bright_green": "#b9f28a",
    "bright_yellow": "#f2c98d",
    "bright_blue": "#9cc4ff",
    "bright_magenta": "#d0b8ff",
    "bright_cyan": "#a4dfff",
    "bright_white": "#c0caf5"
  },

  "semantic": {
    "primary": { "main": "#7aa2f7", "light": "#9cc4ff", "dark": "#5a82d6", "on": "#1a1b26" },
    "secondary": { "main": "#bb9af7", "light": "#d0b8ff", "dark": "#a17de8", "on": "#1a1b26" },
    "accent": { "main": "#e0af68", "light": "#f2c98d", "dark": "#c89a54", "on": "#1a1b26" },
    "error": { "main": "#f7768e", "light": "#ff9aa6", "dark": "#e05a70", "on": "#1a1b26" },
    "warning": { "main": "#e0af68", "light": "#f2c98d", "dark": "#c89a54", "on": "#1a1b26" },
    "success": { "main": "#9ece6a", "light": "#b9f28a", "dark": "#85c852", "on": "#1a1b26" },
    "info": { "main": "#7dcfff", "light": "#a4dfff", "dark": "#5db8e6", "on": "#1a1b26" }
  },

  "state": {
    "hover": { "bg": "#24283b" },
    "active": { "bg": "#414868" },
    "focus": { "bg": "#565f89", "ring": "#7aa2f7" },
    "disabled": { "fg": "#565f89", "bg": "#16161e" },
    "selected": { "bg": "#7aa2f7" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Tokyonight-Dark",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "tokyonight" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}