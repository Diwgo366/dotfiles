{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "gruvbox",
    "description": "Gruvbox Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#282828",
    "bg_alt": "#3c3836",
    "bg_elevated": "#504945",
    "bg_overlay": "#665c54",
    "fg": "#ebdbb2",
    "fg_muted": "#bdae93",
    "fg_subtle": "#928374",
    "border": "#504945",
    "border_focus": "#fe8019",
    "border_subtle": "#3c3836"
  },

  "palette": {
    "black": "#282828",
    "red": "#cc241d",
    "green": "#98971a",
    "yellow": "#d79921",
    "blue": "#458588",
    "magenta": "#b16286",
    "cyan": "#689d6a",
    "orange": "#d65d0e",
    "bright_black": "#928374",
    "bright_red": "#fb4934",
    "bright_green": "#b8bb26",
    "bright_yellow": "#fabd2f",
    "bright_blue": "#83a598",
    "bright_magenta": "#d3869b",
    "bright_cyan": "#8ec07c",
    "bright_white": "#ebdbb2"
  },

  "semantic": {
    "primary": { "main": "#fe8019", "light": "#fabd2f", "dark": "#d65d0e", "on": "#282828" },
    "secondary": { "main": "#83a598", "light": "#8ec07c", "dark": "#458588", "on": "#282828" },
    "accent": { "main": "#d79921", "light": "#fabd2f", "dark": "#b57614", "on": "#282828" },
    "error": { "main": "#cc241d", "light": "#fb4934", "dark": "#9d1e18", "on": "#ebdbb2" },
    "warning": { "main": "#d79921", "light": "#fabd2f", "dark": "#b57614", "on": "#282828" },
    "success": { "main": "#98971a", "light": "#b8bb26", "dark": "#797614", "on": "#282828" },
    "info": { "main": "#83a598", "light": "#8ec07c", "dark": "#458588", "on": "#282828" }
  },

  "state": {
    "hover": { "bg": "#3c3836" },
    "active": { "bg": "#504945" },
    "focus": { "bg": "#665c54", "ring": "#fe8019" },
    "disabled": { "fg": "#928374", "bg": "#3c3836" },
    "selected": { "bg": "#fe8019" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Gruvbox-Dark",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "gruvbox" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}