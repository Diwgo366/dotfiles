{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "nord",
    "description": "Nord Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#2e3440",
    "bg_alt": "#3b4252",
    "bg_elevated": "#434c5e",
    "bg_overlay": "#4c566a",
    "fg": "#eceff4",
    "fg_muted": "#a3b1c6",
    "fg_subtle": "#616e88",
    "border": "#3b4252",
    "border_focus": "#88c0d0",
    "border_subtle": "#363d4f"
  },

  "palette": {
    "black": "#2e3440",
    "red": "#bf616a",
    "green": "#a3be8c",
    "yellow": "#ebcb8b",
    "blue": "#81a1c1",
    "magenta": "#b48ead",
    "cyan": "#88c0d0",
    "orange": "#d08770",
    "bright_black": "#4c566a",
    "bright_red": "#d06f79",
    "bright_green": "#b1d196",
    "bright_yellow": "#ebd59a",
    "bright_blue": "#8fc1d1",
    "bright_magenta": "#c09bc2",
    "bright_cyan": "#93ccdc",
    "bright_white": "#eceff4"
  },

  "semantic": {
    "primary": { "main": "#88c0d0", "light": "#93ccdc", "dark": "#6db0c0", "on": "#2e3440" },
    "secondary": { "main": "#81a1c1", "light": "#8fc1d1", "dark": "#6789b5", "on": "#2e3440" },
    "accent": { "main": "#ebcb8b", "light": "#ebd59a", "dark": "#d4b476", "on": "#2e3440" },
    "error": { "main": "#bf616a", "light": "#d06f79", "dark": "#a84d56", "on": "#eceff4" },
    "warning": { "main": "#ebcb8b", "light": "#ebd59a", "dark": "#d4b476", "on": "#2e3440" },
    "success": { "main": "#a3be8c", "light": "#b1d196", "dark": "#8cab75", "on": "#2e3440" },
    "info": { "main": "#88c0d0", "light": "#93ccdc", "dark": "#6db0c0", "on": "#2e3440" }
  },

  "state": {
    "hover": { "bg": "#3b4252" },
    "active": { "bg": "#434c5e" },
    "focus": { "bg": "#4c566a", "ring": "#88c0d0" },
    "disabled": { "fg": "#616e88", "bg": "#3b4252" },
    "selected": { "bg": "#88c0d0" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Nordic",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "nord" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}