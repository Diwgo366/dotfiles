{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Theme Color Schema",
  "description": "Single source of truth for all theming across the desktop session",
  "version": "1.0.0",

  "metadata": {
    "name": "dracula",
    "description": "Dracula Theme",
    "author": "diego",
    "variant": "dark"
  },

  "base": {
    "bg": "#282a36",
    "bg_alt": "#343746",
    "bg_elevated": "#44475a",
    "bg_overlay": "#4f5264",
    "fg": "#f8f8f2",
    "fg_muted": "#a0a0b0",
    "fg_subtle": "#6272a4",
    "border": "#44475a",
    "border_focus": "#bd93f9",
    "border_subtle": "#3a3a4a"
  },

  "palette": {
    "black": "#21222c",
    "red": "#ff5555",
    "green": "#50fa7b",
    "yellow": "#f1fa8c",
    "blue": "#bd93f9",
    "magenta": "#ff79c6",
    "cyan": "#8be9fd",
    "orange": "#ffb86c",
    "bright_black": "#6272a4",
    "bright_red": "#ff6e6e",
    "bright_green": "#69ff94",
    "bright_yellow": "#ffffa5",
    "bright_blue": "#d6acff",
    "bright_magenta": "#ff92df",
    "bright_cyan": "#a4ffff",
    "bright_white": "#ffffff"
  },

  "semantic": {
    "primary": { "main": "#bd93f9", "light": "#d6acff", "dark": "#9a70d6", "on": "#282a36" },
    "secondary": { "main": "#8be9fd", "light": "#a4ffff", "dark": "#68c6da", "on": "#282a36" },
    "accent": { "main": "#ffb86c", "light": "#ffca9f", "dark": "#e6a25c", "on": "#282a36" },
    "error": { "main": "#ff5555", "light": "#ff6e6e", "dark": "#cc4444", "on": "#f8f8f2" },
    "warning": { "main": "#f1fa8c", "light": "#ffffa5", "dark": "#ccc870", "on": "#282a36" },
    "success": { "main": "#50fa7b", "light": "#69ff94", "dark": "#40c861", "on": "#282a36" },
    "info": { "main": "#8be9fd", "light": "#a4ffff", "dark": "#68c6da", "on": "#282a36" }
  },

  "state": {
    "hover": { "bg": "#44475a" },
    "active": { "bg": "#4f5264" },
    "focus": { "bg": "#585c73", "ring": "#bd93f9" },
    "disabled": { "fg": "#6272a4", "bg": "#343746" },
    "selected": { "bg": "#bd93f9" }
  },

  "alpha": {
    "bg": 0.93,
    "surface": 0.95,
    "overlay": 0.98,
    "border": 1.0,
    "shadow": 0.93
  },

  "typography": {
    "font_family": "CaskaydiaMono Nerd Font",
    "font_size": 10,
    "monospace_family": "CaskaydiaMono Nerd Font Mono",
    "monospace_size": 10
  },

  "spacing": {
    "base": 4,
    "gap": 10,
    "radius": 10,
    "border_width": 2
  },

  "hyprland": {
    "active_opacity": 0.9,
    "inactive_opacity": 0.9,
    "rounding": 10,
    "border_size": 2,
    "gaps_out": 10,
    "blur": { "enabled": false, "size": 1, "passes": 1, "noise": 0.015 },
    "shadow": { "enabled": false, "range": 3, "render_power": 2 }
  },

  "gtk": {
    "theme": "Dracula",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Future-cyan-cursors",
    "color_scheme": "prefer-dark"
  },

  "apps": {
    "kitty": { "draw_minimal_borders": false },
    "nvim": { "style": "dark" },
    "starship": { "palette_name": "dracula" },
    "wofi": { "format": "pywal" },
    "zsh": { "format": "ansi" },
    "ags": { "css_priority": "application" }
  }
}