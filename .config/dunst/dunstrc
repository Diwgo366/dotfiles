# Configuración personal de Dunst.

[global]
origin = bottom-right
offset = (0, 50)
width = 360
height = (0, 180)
notification_limit = 3

[urgency_low]
timeout = 5s
override_dbus_timeout = true

[urgency_normal]
timeout = 5s
override_dbus_timeout = true

[urgency_critical]
timeout = 5s
override_dbus_timeout = true
